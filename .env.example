# Copy this file to ".env" and edit the values. Never commit ".env" to git.

# What Jarvis calls you
USER_NAME=Sir

# Words that wake Jarvis up (comma separated, lowercase).
# Google's speech engine sometimes mishears "jarvis", so add aliases here.
WAKE_WORDS=jarvis,jarvish,jarvas

# City used when you just say "weather"
DEFAULT_CITY=Gurugram

# OPTIONAL: gives Jarvis a real AI brain for open-ended questions.
# Get a key at https://console.anthropic.com  (leave empty to disable)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Voice speed (words per minute) and volume (0.0 - 1.0)
VOICE_RATE=185
VOICE_VOLUME=1.0
