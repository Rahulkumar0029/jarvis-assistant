# Copy this file to ".env" and edit the values. Never commit ".env" to git.

# What Jarvis calls you
USER_NAME=Sir

# Words that wake Jarvis up (comma separated, lowercase).
# Google's speech engine sometimes mishears "jarvis", so add aliases here.
WAKE_WORDS=jarvis,jarvish,jarvas

# City used when you just say "weather"
DEFAULT_CITY=Gurugram

# AI Brain Provider: gemini | groq | ollama | anthropic | none
AI_PROVIDER=gemini

# Google Gemini (Free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (Free fast inference at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (100% Free local AI at https://ollama.com/download)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OPTIONAL: Anthropic (paid, legacy)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Voice speed (words per minute) and volume (0.0 - 1.0)
VOICE_RATE=185
VOICE_VOLUME=1.0
